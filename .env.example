# Copy to .env.local and fill in from Supabase dashboard → Project Settings → API.
# Without these, TermType runs guest-only (auth UI is hidden).
NEXT_PUBLIC_SUPABASE_URL=
# Either name works; newer projects call it the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY - never prefix with NEXT_PUBLIC_ and never commit the real value.
# Lets /api/results save validated runs (Project Settings → API Keys → service_role
# or secret key). Without it, saving is disabled and guests are unaffected.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Comma-separated OAuth providers to show on the login form, e.g. github,google.
# Enable each one in Supabase → Authentication → Providers first. Empty = email only.
NEXT_PUBLIC_AUTH_PROVIDERS=
